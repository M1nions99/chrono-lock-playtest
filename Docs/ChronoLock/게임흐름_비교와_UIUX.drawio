=1;whiteSpace=wrap;html=0;fillColor=#193448;strokeColor=#3D6178;fontColor=#EAF3FA;fontSize=17;fontFamily=Malgun Gothic;align=left;verticalAlign=middle;spacing=14;" value="뒤로 / ESC&#10;변경 없음 → 원래 메뉴&#10;미적용 변경 → 버리기 확인" vertex="1"><mxGeometry height="100" width="365" x="1080" y="695" as="geometry"/></mxCell><mxCell id="e25" edge="1" parent="1" source="n21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#67CFC9;fontColor=#C3DEE8;fontSize=13;fontFamily=Malgun Gothic;labelBackgroundColor=#0C1724;endArrow=block;endFill=1;" target="n22" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" edge="1" parent="1" source="n22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#67CFC9;fontColor=#C3DEE8;fontSize=13;fontFamily=Malgun Gothic;labelBackgroundColor=#0C1724;endArrow=block;endFill=1;" target="n23" value="적용"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" edge="1" parent="1" source="n23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#67CFC9;fontColor=#C3DEE8;fontSize=13;fontFamily=Malgun Gothic;labelBackgroundColor=#0C1724;endArrow=block;endFill=1;" target="n24" value="뒤로"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#15313A;strokeColor=#3D6178;fontColor=#EAF3FA;fontSize=17;fontFamily=Malgun Gothic;align=left;verticalAlign=middle;spacing=14;" value="Space / 건너뛰기 → 바로 같은 구조실에 선 상태. 방과 침대는 계속 남아 탐색할 수 있습니다.&#10;J 기록: 발견 기록 / 구간 통신 탭. 첫 기록은 시작부터, 나머지는 3퍼즐 진행에 따라 해제." vertex="1"><mxGeometry height="60" width="1395" x="50" y="835" as="geometry"/></mxCell><mxCell id="n29" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#15313A;strokeColor=#3D6178;fontColor=#EAF3FA;fontSize=17;fontFamily=Malgun Gothic;align=left;verticalAlign=middle;spacing=14;" value="F1 조작 안내 · H 힌트: 게임 중 열면 시간 정지, 닫으면 게임 복귀. 일시정지에서 열면 일시정지로 복귀.&#10;힌트는 3단계 선택 공개. 목표 문구는 해법을 바로 노출하지 않습니다." vertex="1"><mxGeometry height="60" width="1395" x="50" y="915" as="geometry"/></mxCell><mxCell id="n30" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0C1724;strokeColor=none;fontColor=#9FB5CB;fontSize=14;fontFamily=Malgun Gothic;align=left;verticalAlign=middle;spacing=14;" value="범위: 실제 버튼·키보드 전체 검증을 뜻하지 않습니다. 이 페이지는 현재 소스의 메뉴 전환과 저장 정책을 설명합니다." vertex="1"><mxGeometry height="35" width="1395" x="50" y="1010" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="NpCJc7In5THmvX00zWkA" name="02 개선 전후 비교"><mxGraphModel dx="1364" dy="973" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" background="#0C1724" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0C1724;strokeColor=none;fontColor=#FFFFFF;fontSize=30;fontFamily=Malgun Gothic;align=left;verticalAlign=middle;spacing=14;" value="02  부족했던 부분 → 현재 대응" vertex="1"><mxGeometry height="55" width="1420" x="40" y="25" as="geometry"/></mxCell><mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0C1724;strokeColor=none;fontColor=#9FB5CB;fontSize=15;fontFamily=Malgun Gothic;align=left;verticalAlign=middle;spacing=14;" value="메뉴·사용성 비교 / Portal 2 UI 항목 참고: interfaceingame.com/games/portal-2/ / 맵·퍼즐 확장은 후속 범위" vertex="1"><mxGeometry height="40" width="1420" x="40" y="85" as="geometry"/></mxCell><mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#582E3E;strokeColor=#3D6178;fontColor=#EAF3FA;fontSize=23;fontFamily=Malgun Gothic;align=left;verticalAlign=middle;spacing=14;" value="개선 전" vertex="1"><mxGeometry height="50" width="520" x="50" y="145" as="geometry"/></mxCell><mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#184B50;strokeColor=#3D6178;fontColor=#EAF3FA;fontSize=23;fontFamily=Malgun Gothic;align=left;verticalAlign=middle;spacing=14;" value="현재 구현" vertex="1"><mxG